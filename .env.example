# YC Work at a Startup Auth
# You can obtain this by logging into workatastartup.com and copying the value of the _bf_session_key cookie.
YC_WAAS_SESSION_KEY=your_session_key_here

# OpenRouter LLM Auth (Only required if you implement the Tier 3 / Stage 2 LLM classifier in Phase 2)
# The current pipeline uses fast, regex-based classification (filters.py) and does not strictly require this key.
OPENROUTER_API_KEY=your_openrouter_key_here

# WhatsApp Notifications (Optional)
CALLMEBOT_APIKEY=your_callmebot_key
WHATSAPP_PHONE=your_phone_number
